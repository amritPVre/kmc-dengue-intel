{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["bom1"],
  "functions": {
    "api/weather.js": { "maxDuration": 60, "includeFiles": "src/data/**" },
    "api/sources.js": { "maxDuration": 60 },
    "api/vision.js": { "maxDuration": 60 },
    "api/satellite.js": { "maxDuration": 300, "includeFiles": "src/data/**" },
    "api/landscape.js": { "maxDuration": 300, "includeFiles": "src/data/**" },
    "api/osm.js": { "maxDuration": 300, "includeFiles": "src/data/**" },
    "api/cron.js": { "maxDuration": 300, "includeFiles": "src/data/**" }
  },
  "crons": [{ "path": "/api/cron", "schedule": "30 0 * * *" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
